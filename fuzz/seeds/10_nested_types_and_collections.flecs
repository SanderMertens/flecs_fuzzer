using flecs.meta

struct Vec2 {
  x = f32
  y = f32
}

struct PID {
  p = f64
  i = f64
  d = f64
}

struct Controller {
  gains = PID
  direction = Vec2
  setpoint = f64
}

struct ControlPair {
  left = Controller
  right = Controller
}

FibArray {
  array: {type: i32, count: 7}
}

FibVector {
  vector: {type: i32}
}

controller_entity {
  FibArray: [1, 2, 3, 5, 8, 13, 21]
  FibVector: [1, 2, 3, 5, 8, 13, 21]

  ControlPair: {
    left: {
      gains: {p: 1.0 / 1.0e2, i: 2.5 / 1.0e3, d: 5.0 / 1.0e4}
      direction: {x: 1, y: 0}
      setpoint: 2.5e2
    }
    right: {
      gains: {p: 3.0 / 1.0e2, i: 1.0 / 1.0e3, d: 7.5 / 1.0e4}
      direction: {x: 0, y: 1}
      setpoint: 7.5e1
    }
  }
}
