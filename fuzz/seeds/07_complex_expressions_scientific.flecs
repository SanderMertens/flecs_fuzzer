using flecs.meta

struct ExpressionSample {
  base = f64
  shifted = i32
  mixed = f64
  ratio = f64
  gate = bool
}

const base: 1.25e2
const shifted: (3 << 4) + (64 >> 3)
const mixed: ((($base + 5.0e1) / 2.5) - ($shifted % 7)) / 3.0
const ratio: ($base / (($mixed * $mixed) + 1.0))
const gate: (($mixed >= 10.0) && ($mixed < 1.0e2)) || false

expr_entity {
  ExpressionSample: {
    base: $base
    shifted: $shifted
    mixed: $mixed
    ratio: $ratio
    gate: $gate
  }
}
