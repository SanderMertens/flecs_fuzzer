using flecs.meta

Vertex {}
Fragment {}

struct Shader {
  filename = string
  code = string
}

my_pipeline {
  (Shader, Vertex): {
    filename: "vert.glsl",
    code: `
      void main() \{
        gl_Position = pos;
      }`
    }

  (Shader, Fragment): {
    filename: "frag.glsl",
    code: `
      void main() \{
        frag_color = color;
      }`
    }
}
