using flecs.meta
using flecs.script.math

Planet {}
Station {}
Faction {}
Engine {}
Rel {}
Tgt {}

struct Position {
  x = f32
  y = f32
}

struct Velocity {
  x = f32
  y = f32
}

struct Nameplate {
  value = string
}

struct Orbit {
  radius = f64
  phase = f64
}

struct Combat {
  attack = f32
  defense = f32
}

struct Flags {
  fast = bool
}

struct Vec2 {
  x = f32
  y = f32
}

struct Vec3 {
  x = f64
  y = f64
  z = f64
}

struct PID {
  p = f64
  i = f64
  d = f64
}

struct Controller {
  gains = PID
  direction = Vec2
  setpoint = f64
}

struct EngineProfile {
  thrust = f64
  efficiency = f64
  axis = Vec3
}

struct Shader {
  filename = string
  code = string
}

enum Team {
  Red,
  Blue
}

const base_speed: 3.2e1
const shift_factor: (3 << 3) + (64 >> 4)
const orbit_radius: sqrt(9.0e2) + 2.5
const trig_mix: sin(PI / 6.0) + cos(PI / 3.0) + tan(PI / 4.0)
const damping: (exp2(3.0) - log10(1.0e3)) / 10.0
const cruise_speed: (($base_speed + ($shift_factor % 7)) * (1.0 + $damping))
const gate_fast: (($cruise_speed > 30.0) && ($orbit_radius < 40.0)) || false

const axis = Vec3: {3.0, 4.0, 0.0}
const unit_axis: normalize($axis)
const probe = Vec3: {1.0e1, -2.5, 3.5}
const mixed_axis: lerp($probe, $unit_axis, 0.35)
const axis_len: length($axis)

Earth { Planet }
Mars { Planet }

template EnginePack {
  prop thrust = flecs.meta.f64: 120.0
  prop efficiency = flecs.meta.f64: 0.82
  prop orbit_phase = flecs.meta.f64: 0.0

  engine {
    Engine
    EngineProfile: {
      thrust: $thrust + ($cruise_speed / 2.0)
      efficiency: $efficiency
      axis: $mixed_axis
    }
    Orbit: {
      radius: $orbit_radius + ($thrust / 100.0)
      phase: $orbit_phase + ($trig_mix / 10.0)
    }
    Velocity: {
      x: $cruise_speed * 0.1
      y: ($cruise_speed / 5.0) - 1.0
    }
  }
}

template PatrolGroup {
  prop count = flecs.meta.i32: 3
  prop spacing = flecs.meta.f32: 2
  prop attack = flecs.meta.f32: 5
  prop defense = flecs.meta.f32: 3

  for i in 0..$count {
    "unit_{$i}" {
      Position: {
        x: ($i * $spacing) + ($shift_factor % 5)
        y: ($i * 0.5) - 1
      }
      Combat: {
        attack: $attack + ($i * 0.75)
        defense: $defense + ($i * 0.25)
      }
      Team: {Red}
    }
  }
}

template SensorNode {
  prop idx = flecs.meta.i32: 0
  prop px = flecs.meta.f32: 0
  prop py = flecs.meta.f32: 0

  "sensor_{$idx}" {
    Position: {$px + ($idx * 1.5), $py - ($idx * 0.5)}
    Nameplate: {"sensor node"}
    Team: {Blue}
  }
}

@tree Parent
parent_root {
  Nameplate: {"parent storage root"}
  Position: {x: 0, y: 0}
  Orbit: {radius: $orbit_radius, phase: $trig_mix}

  fleet_alpha {
    (Faction, Earth)
    Team: {Red}
    EnginePack: {thrust: 180, efficiency: 0.91, orbit_phase: 0.25}
    PatrolGroup: {count: 4, spacing: 2.5, attack: 7, defense: 4}
  }

  fleet_beta {
    (Faction, Mars)
    Team: {Blue}
    EnginePack: {thrust: 140, efficiency: 0.88, orbit_phase: 0.75}

    {
      Nameplate: {"anonymous maintenance bay"}
      SensorNode: {idx: 2, px: -4, py: 2}
    }
  }
}

@tree ChildOf
childof_root {
  Nameplate: {"childof storage root"}
  Position: {x: -10, y: 5}

  dock_a {
    EnginePack: {thrust: 110, efficiency: 0.8, orbit_phase: 1.5}
    SensorNode: {idx: 0, px: 1, py: 1}
  }

  dock_b {
    PatrolGroup: {count: 2, spacing: 3.0, attack: 6, defense: 5}

    @tree Parent
    parent_section {
      nested_parent_a {
        Position: {x: 4, y: 8}
      }
      nested_parent_b {
        Position: {x: 5, y: 9}
      }
    }
  }
}

mixed_root {
  Nameplate: {"mixed/default hierarchy root"}
  Orbit: {radius: $orbit_radius + $axis_len, phase: $trig_mix + $damping}
  Combat: {
    attack: ($cruise_speed / 3.0) + 1
    defense: (abs(-4.0) + 2.0)
  }

  controller_node {
    Controller: {
      gains: {p: 1.0 / 1.0e2, i: 2.5 / 1.0e3, d: 5.0 / 1.0e4}
      direction: {x: 1, y: 0}
      setpoint: ($orbit_radius * 2.0) + ($axis_len / 2.0)
    }
  }

  shader_bank {
    (Shader, Station): {
      filename: "station.glsl",
      code: `
        void main() \{
          gl_Position = vec4(0.0);
        }`
      }
  }

  @tree Parent
  parent_zone {
    (Rel, Tgt) {
      relay {
        @tree ChildOf
        links {
          link_a {}
          link_b {}
        }
      }
    }
  }

  gate_marker {
    Nameplate: {"fast gate marker"}
    Flags: {fast: $gate_fast}
  }
}
