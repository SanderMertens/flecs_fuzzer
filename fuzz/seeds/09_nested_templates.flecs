using flecs.meta

struct Position {
  x = f32
  y = f32
}

struct Weight {
  value = f32
}

template Leaf {
  prop idx = flecs.meta.i32: 0
  prop base = flecs.meta.f32: 1

  "leaf_{$idx}" {
    Position: {$idx * 1.5, $base + $idx}
    Weight: {$base + ($idx * 0.5)}
  }
}

template Cluster {
  prop count = flecs.meta.i32: 3
  prop base = flecs.meta.f32: 0
  prop offset = flecs.meta.f32: 0

  for i in 0..$count {
    Leaf: {idx: $i, base: $base + $offset}
  }
}

template Branch {
  prop count = flecs.meta.i32: 3
  prop base = flecs.meta.f32: 2

  left { Cluster: {count: $count, base: $base, offset: -2} }
  right { Cluster: {count: $count, base: $base, offset: 3} }
}

tree_a { Branch: {count: 4, base: 1.5} }
tree_b { Branch: {count: 2, base: 4.0} }
